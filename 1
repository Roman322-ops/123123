//пузырек
void bubble_1(int* m, int n) { //не трогаем отсортированное    
	for (int i = 0; i < n - 1; i++) {//по массиву  //не трогаем отсортированное 
		for (int j = 0; j < n - i - 1; j++) {// по от начю до неотсорт. границы  //не трогаем отсортированное 
			if (m[j] > m[j + 1]) {
				int p = m[j];//p- врем. переменная
				m[j] = m[j + 1];
				m[j + 1] = p;
			}
		}
	}
}

void optim_bubble_1(int* m, int n) {//отслеживание обменов
	for (int i = 0; i < n - 1; i++) {//по массиву
		bool swapped = false;// <-
		for (int j = 0; j < n - i - 1; j++) {// по от начю до неотсорт. границы
			if (m[j] > m[j + 1]) {
				swapped = true; // <-
				int p = m[j];//p- врем. переменная
				m[j] = m[j + 1];
				m[j + 1] = p;
			}
		}
		if (!swapped) break;// <-
	}
}

void optim_bubble_2(int* m, int n) { //шейкерная сортировка
	int left_i = 0;
	int right_i = n - 1;//конец массива
	while (true) {
		bool swapped = false;//признак состоявшегося обмена в массиве
		for (int i = left_i; i < right_i; i++) {// топим больший элементы
			if (m[i] > m[i + 1]) {
				swapped = true;
				int p = m[i+1];
				m[i+1] = m[i];
				m[i] = p;
			}
		}
		right_i--;// сдвигаем границу
		if ((left_i < right_i) && swapped) { // если границы сортировки не смкнулись и были обмены, то продолжаем сортировку
			swapped = false;
			for (int j = right_i; j > left_i; j--) {// выталкиваем меньший элементы
				if (m[j] < m[j - 1]) {
					swapped = true;
					int p = m[j - 1];
					m[j - 1] = m[j];
					m[j] = p;
				}
			}
			left_i++;
			if (!swapped || (left_i == right_i)) break; // проверяем на смыкание границ и на отсутствие перестановок
		}
		else break; // если условие не выполняется, то массив отсортирован
	}
}

//quit sort
void swap_ab(int& a, int& b) {
	int p = a;
	a = b;
	b = p;
}
int part(int* m, int low, int high) {
	int p = m[high]; // выбор последнего элемента в качестве опорного
	int i = low - 1;// индекс элемента, меньший, чем точка поворота

	for (int j = low; j < high; j++) {
		// если текущий элемент меньше или равен
		if (m[j] <= p) {
			i++;
			swap_ab(m[i], m[j]);
		}
	}

	swap_ab(m[i + 1], m[high]);

	return i + 1;
}
void quit_sort_help(int* m, int low, int high) {
	if (low < high) {

		// массив на разделы
		int p = part(m, low, high);

		quit_sort_help(m, low, p - 1);

		quit_sort_help(m, p + 1, high);
	}
}
void quit_sort(int* m, int n) {
	if (n > 1)
	{
		quit_sort_help(m, 0, n - 1);
	}
}

//mearge_sort
void merge(int* m, int left, int mid, int right) {
	int size = right - left + 1;
	int* t = new int[size];

	int i = left;
	int j = mid +1;
	int k = 0;

	while (i <= mid && j <= right) {
		if (m[i] <= m[j]) {
			t[k++] = m[i++];
		}
		else {
			t[k++] = m[j++];
		}
	}
	while (i <= mid) {
		t[k++] = m[i++];
	}
	while (j <= right) {
		t[k++] = m[j++];
	}

	for (int p = 0; p < size; ++p) {
		m[left + p] = t[p];
	}
	delete[] t;
}
void mergeSort(int* m, int left, int right) {
	if (left >= right) return;
	int mid = left + (right - left) / 2;
	mergeSort(m, left, mid);
	mergeSort(m, mid + 1, right);
	merge(m, left, mid, right);
}
void merge_sort(int* m, int n) {
	if (n > 0) {
		mergeSort(m, 0, n - 1);
	}
}

//ПИМРАМИДА (КУЧА)
void heapify(int* m, int n, int i) {
	int root = i;
	// инициализируем наибольший элемент как корень
	int l = 2 * i + 1; // левый = 2*i + 1
	int r = 2 * i + 2; // правый = 2*i + 2
	// если левый дочерний элемент больше корня
	if (l < n && m[l] > m[root])
		root = l;
	// если правый дочерний элемент больше, чем самый большой элемент на данный момент
	if (r < n && m[r] > m[root])
		root = r;
	// если самый большой элемент не корень
	if (root != i)
	{
		swap_ab(m[i], m[root]);

		// рекурсивно преобразуем в двоичную кучу затронутое поддерево
		heapify(m, n, root);
	}
}
void heap_sort(int* m, int n) {
	// построение кучи (
	for (int i = n / 2 - 1; i >= 0; i--)
		heapify(m, n, i);

	// извлекаем элементы из кучи
	for (int i = n - 1; i >= 0; i--)
	{
		//  корень в конец
		swap_ab(m[0], m[i]);

		heapify(m, i, 0);//куча меньше
	}
}

void frand(int* m, int n) {
	for (int i = 0; i < n; i++) {
		m[i] = rand() % 1000000;
	}
}

